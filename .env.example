# Copy to .env:  cp .env.example .env
# Then set AIRFLOW_UID to your macOS user id:  id -u
#
# Local Docker setup (not committed):
#   cp docker-compose.example.yaml docker-compose.yaml
#
# Set strong values below before running docker compose up.

AIRFLOW_UID=50000

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# pgAdmin (local dev only)
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Airflow web UI (created on first init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Airflow API / JWT (generate a long random string)
AIRFLOW__API_AUTH__JWT_SECRET=change-me-generate-a-long-random-string
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Optional overrides
# AIRFLOW_IMAGE_NAME=airflow-extended:3.1.8
# AIRFLOW_PROJ_DIR=.
# ENV_FILE_PATH=.env
