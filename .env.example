# Copy to .env:  cp .env.example .env
# Then set AIRFLOW_UID to your macOS user id:  id -u
#
# Local Docker setup (not committed):
#   cp docker-compose.example.yaml docker-compose.yaml

AIRFLOW_UID=50000

# Optional overrides (defaults are fine for local dev)
# AIRFLOW_IMAGE_NAME=airflow-extended:3.1.8
# AIRFLOW_PROJ_DIR=.
# ENV_FILE_PATH=.env

# Airflow web UI (set in compose if you customize)
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
